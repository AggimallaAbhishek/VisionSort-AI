# AWS
AWS_REGION=eu-north-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# S3
S3_UPLOADS_BUCKET=visionsort-uploads-vin
S3_PROCESSED_BUCKET=visionsort-processed-vin

# PostgreSQL (AWS RDS)
DATABASE_URL=postgresql://user:password@host:5432/database

# API behavior
ALLOWED_ORIGINS=https://vision-sort-ai.vercel.app,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://localhost:5173
ALLOWED_ORIGIN_REGEX=^https://.*\\.vercel\\.app$
DEFAULT_USER_ID=anonymous
BLUR_THRESHOLD=100
DUPLICATE_HASH_DISTANCE=5
MAX_IMAGE_WIDTH=1024
PREVIEW_MAX_WIDTH=640
PREVIEW_JPEG_QUALITY=70
INCLUDE_PREVIEW_DATA_URL=true
PREVIEW_INLINE_MAX_FILES=20
MAX_FILE_SIZE_MB=100
MAX_REQUEST_TOTAL_MB=40
MAX_FILES=50
RENAMED_FILE_PREFIX=vin_img
SPOOL_UPLOADS_TO_DISK=true
ENABLE_AI_LABEL=true
DISABLE_AI_ON_LOW_MEMORY=true
LOW_MEMORY_RAM_MB_THRESHOLD=700
AI_ASSISTED_STATUS=true
AI_FASTPATH_SKIP_STRONG_RULES=true
AI_DISABLE_ABOVE_FILES=24
AI_MIN_CONFIDENCE=0.70
AI_PROMOTE_GOOD_CONFIDENCE=0.90
AI_BORDERLINE_FACTOR=0.90
DARK_PROMOTE_MIN_BRIGHTNESS=45
OVEREXPOSED_PROMOTE_MAX_BRIGHTNESS=210
PERSIST_WORKERS=6
PERSIST_WORKERS_MAX_SAFE=2
UPLOAD_JOB_WORKERS=2
UPLOAD_JOB_WORKERS_MAX_SAFE=1
JOB_RETENTION_MINUTES=60

# Timeout tuning (prevents long hanging uploads)
PERSIST_TASK_TIMEOUT_SECONDS=30
PERSIST_OVERALL_TIMEOUT_SECONDS=90
S3_CONNECT_TIMEOUT_SECONDS=3
S3_READ_TIMEOUT_SECONDS=12
S3_MAX_ATTEMPTS=2
DB_CONNECT_TIMEOUT_SECONDS=8
DB_STATEMENT_TIMEOUT_MS=15000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=30
MAX_ZIP_ITEMS=400
MAX_ZIP_SOURCE_BYTES_MB=500
